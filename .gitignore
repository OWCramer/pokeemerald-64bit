# native 64-bit build binaries: pokeemerald64 (Linux/macOS SDL3), pokeemerald-ios,
# any custom-FILE_NAME variants (e.g. pokeemerald-mig64), and their .dSYM bundles.
# Object dirs under build/ are covered by `build/` above; the Android libmain.so
# by the jniLibs rule below.
/pokeemerald
/pokeemerald*64
/pokeemerald-ios
/pokeemerald-*-ios
/pokeemerald*-sdl3
/pokeemerald*.dSYM/

# alternate build dirs (custom BUILD_DIR, e.g. build-linux) and the packaging
# staging/output dir written by tools/make_{appimage,tarball,pacman}.sh
/build-*/
/dist/
# audio/video capture from the diagnostic hooks
*.wav
*.ppm
emerald_debug.log

# Android: Gradle outputs, staged native libs, vendored SDL, and machine paths
/android/build/
/android/app/build/
/android/.gradle/
/android/app/src/main/jniLibs/
/android/local.properties
# build-android/ (vendored SDL source + per-abi builds) is covered by /build-*/
