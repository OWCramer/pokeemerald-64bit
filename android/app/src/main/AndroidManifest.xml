<?xml version="1.0" encoding="utf-8"?>
<!-- versionCode / versionName are set from build.gradle (derived from the git
     tag in CI); do not hardcode them here or the manifest values win. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto">

    <uses-feature android:glEsVersion="0x00020000" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.type.pc" android:required="false" />

    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- allowBackup: the save the game plays from lives in the app's internal
         files directory (see ResolveSavePath in sdl3.c). That is one of the
         directories Auto Backup covers by default, which is what Google One
         lists as this app's data, and at 128 KB it is well under the 25 MB cap.

         It stays covered only while there are no custom backup rules. Declaring
         android:fullBackupContent or android:dataExtractionRules makes the set
         exclusive, so anything added later must keep domain="file" or the save
         silently stops being backed up.

         The user-facing copy in the folder picked at first launch (SaveMirror)
         is deliberately NOT the backed-up one: it lives in shared storage,
         which Auto Backup does not cover. Internal is what Google restores onto
         a new phone, and the mirror is re-seeded from it on first launch there. -->
    <!-- appCategory is what makes the system treat this as a game rather than
         a generic app: Game Mode and the Game Dashboard overlay (Android 12+,
         screenshots, recording, FPS, Do Not Disturb) only attach to apps in the
         game category, and launchers and Settings' per-category storage and
         battery breakdowns use the same signal. -->
    <application android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:appCategory="game"
        android:allowBackup="true"
        android:theme="@style/AppTheme"
        android:hardwareAccelerated="true" >

        <!-- Never offer "New window". Desktop shells (Android's own desktop
             windowing, DeX, ChromeOS) put a multi-instance affordance on apps
             that declare support for one; this app must not have it. Two windows
             would be two views of one process's globals: one emulated GBA, one
             flash image, one save file being written from both. The second
             instance has nothing to show but a corrupted save.

             Declared false rather than left out: absent means "no opinion", and
             the affordance is the sort of thing a future release turns on by
             default for resizeable apps. The real guarantee is launchMode below;
             this is what stops the system from offering what it cannot deliver. -->
        <property
            android:name="android.window.PROPERTY_SUPPORTS_MULTI_INSTANCE_SYSTEM_UI"
            android:value="false" />

        <!-- The launcher entry is the save-folder doorway, not the game: the
             folder question has to be answered before the game process starts
             and reads its save. It starts GameActivity and finishes, so it is
             on screen for a frame at most, and excludeFromRecents keeps its
             task out of the recents list, so the only task the user ever sees
             is the game's. No noHistory: that would destroy this activity the
             moment the picker opens, and the result would never come back. -->
        <activity android:name=".SaveSetupActivity"
            android:label="@string/app_name"
            android:theme="@style/SetupTheme"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:documentLaunchMode="never"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="true"
            >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- GameActivity extends SDLActivity, whose default getLibraries()
             loads SDL3 then "main" (our libmain.so) and whose getMainFunction()
             returns "SDL_main"; it adds the save mirror and nothing else.

             singleInstance is what makes the game single-instance for real, and
             not only by convention: the system allows exactly one instance of
             such an activity, alone in its task, and every later launch is
             delivered to it through onNewIntent instead of creating a second.
             That is also why the launcher activity above hands off to it and
             gets out of the way.

             documentLaunchMode="never" refuses FLAG_ACTIVITY_NEW_DOCUMENT and
             FLAG_ACTIVITY_MULTIPLE_TASK, the two flags a caller would otherwise
             use to ask for a second task; exported="false" means nothing outside
             the app can aim an intent here at all. -->
        <activity android:name=".GameActivity"
            android:label="@string/app_name"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleInstance"
            android:documentLaunchMode="never"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:preferMinimalPostProcessing="true"
            android:exported="false"
            />
    </application>

</manifest>
